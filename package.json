{
  "name": "garage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "bin": {
    "garage": "./bin/garage"
  },
  "scripts": {
    "dev": "vite",
    "build:garage": "tsc --noEmit && vite build",
    "build:apps": "node scripts/lib/build-apps.mjs",
    "sync-catalog": "node scripts/garage.mjs sync-catalog",
    "prebuild": "npm run sync-catalog",
    "build": "npm run build:garage && npm run build:apps",
    "preview": "vite preview",
    "test": "vitest run",
    "garage": "node scripts/garage.mjs",
    "deploy": "node scripts/garage.mjs deploy --all"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "firebase-tools": "^13.29.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
